{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests --reporter=basic",
    "test:pipeline": "bash ./scripts/run-pipeline-tests.sh",
    "test:real": "RUN_REAL_E2E=true vitest run src/server/__tests__/pipeline.e2e.real.test.ts --pool=threads --maxWorkers=1 --reporter=basic",
    "test:drift:unit": "vitest run src/drift/__tests__/*.test.ts src/server/__tests__/drift.routes.test.ts --pool=threads --maxWorkers=1 --reporter=basic",
    "test:drift:real": "RUN_REAL_DRIFT_E2E=true vitest run src/drift/__tests__/drift.e2e.real.test.ts --pool=threads --maxWorkers=1 --reporter=basic",
    "test:drift:mutating": "RUN_DRIFT_MUTATING=true DRIFT_MUTATING_MAINNET_ACK=I_ACCEPT_RISK vitest run src/drift/__tests__/drift.e2e.mutating.real.test.ts --pool=threads --maxWorkers=1 --reporter=basic"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.29.0",
    "@drift-labs/sdk": "^2.87.0",
    "@meteora-ag/dlmm": "^1.7.0",
    "@meteora-ag/dlmm-sdk": "^0.3.0",
    "@orca-so/common-sdk": "^0.6.11",
    "@orca-so/tx-sender": "^1.0.2",
    "@orca-so/whirlpools": "^4.0.0",
    "@orca-so/whirlpools-client": "^4.0.0",
    "@orca-so/whirlpools-core": "^2.0.0",
    "@orca-so/whirlpools-sdk": "^0.16.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.25-alpha",
    "@solana/kit": "^2.1.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.0",
    "bn.js": "^5.2.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "undici": "^6.19.8",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "rpc-websockets": "9.1.3",
    "@solana/web3.js": "1.98.0"
  }
}
