# Required
SOLANA_RPC_URL=https://your-rpc-provider.com/?api-key=YOUR_API_KEY

# Optional - Backend server
PORT=3001
WALLET_PATH=./wallet/keypair.json

# Optional - Rate limiting
API_MIN_GAP_MS_BASE=200
API_MIN_GAP_MS_MIN=100
API_MIN_GAP_MS_MAX=2000

# Optional - Arbitrage service connection
ARB_HOST=127.0.0.1
ARB_PORT=4010
ARB_SHARED_SECRET=your-shared-secret-here
ARB_WAIT_FOR_DETECT=false
ARB_ACK_TIMEOUT_MS=2500

# Optional - Pool fetching
ORCA_MODE=http
RAYDIUM_ONCHAIN=false
METEORA_MODE=http
POOLS_REFRESH_MS=30000
SCOPE_POOLS_MODE=jupiter

# Optional - Shyft API (for PumpSwap pools)
SHYFT_API_KEY=your-shyft-api-key

# Optional - Drift Protocol
DRIFT_BOTS_ENABLED=false
DRIFT_BOTS_SECRET=

# Optional - Authentication (for production)
AUTH_USER=
AUTH_PASS=
